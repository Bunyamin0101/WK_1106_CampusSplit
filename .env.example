# Für den VS-Code-Debugger nach .env kopieren und lokal ausfüllen.
# Maven lädt .env NICHT automatisch: Variablen vorher im Terminal exportieren.
DB_URL=jdbc:postgresql://localhost:5432/campussplit
DB_USER=campussplit
DB_PASSWORD=
SERVER_PORT=8087
FRANKFURTER_BASE_URL=https://api.frankfurter.dev
# Optionaler Google-Login; Werte nur lokal in .env eintragen.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=